# ---------------------------------------------------------------------------
# Fabulous Cartz API — environment
# Copy to .env and adjust. SQLite is the local default; for Postgres change
# DATABASE_URL to postgresql://... and update prisma/schema.prisma provider.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# SQLite (relative to prisma/schema.prisma -> backend/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Auth. Generate with: openssl rand -hex 32
JWT_SECRET="dev-access-secret-change-me-0123456789abcdef"
REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# CORS (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Public base URL used for media URLs
PUBLIC_BASE_URL="http://localhost:4000"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="5242880"

# Payments. The mock driver works out of the box; real providers are adapters.
PAYMENT_DEFAULT_PROVIDER="mock"
MOCK_WEBHOOK_SECRET="mock-webhook-secret"
PHONEPE_WEBHOOK_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
PHONEPE_MERCHANT_ID=""
PHONEPE_SALT_KEY=""

# Notifications outbox driver: mock (logs) | smtp (adapter stub)
NOTIFICATION_DRIVER="mock"
