{
  "name": "@fabulouscartz/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Fabulous Cartz commerce API — storefront + admin back office",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:backoffice": "npm --prefix ../admin run build && node scripts/copy-admin-dist.mjs",
    "start:backoffice": "npm run build:backoffice && npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "test:db": "DATABASE_URL=file:./test.db prisma db push --force-reset --skip-generate && DATABASE_URL=file:./test.db tsx prisma/seed.ts",
    "test": "npm run test:db && vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/etag": "^6.2.1",
    "@fastify/multipart": "^9.2.0",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
